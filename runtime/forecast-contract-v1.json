{
  "schema_version": 1,
  "contract_id": "REI-FORECAST/1.0-alpha1",
  "status": "CANDIDATE",

  "forecast_type": "binary_probability",

  "required_t0_fields": [
    "forecast_id",
    "schema_version",
    "created_at_utc",
    "cutoff_at_utc",
    "resolve_at_utc",
    "question",
    "target_type",
    "probability",
    "abstain",
    "evidence_bundle_hash",
    "model_id"
  ],

  "target_type": "binary",

  "probability_constraints": {
    "minimum": 0.0,
    "maximum": 1.0
  },

  "status_values": [
    "DRAFT",
    "COMMITTED"
  ],

  "immutable_after_commit": [
    "forecast_id",
    "schema_version",
    "created_at_utc",
    "cutoff_at_utc",
    "resolve_at_utc",
    "question",
    "target_type",
    "probability",
    "abstain",
    "evidence_bundle_hash",
    "model_id"
  ],

  "authority": {
    "canonical_write_permission": false,
    "automatic_promotion_permission": false,
    "automatic_reality_validation_permission": false,
    "automatic_ascension_permission": false
  },

  "hard_rules": [
    "CommittedForecastIsImmutable",
    "NoPostCutoffEvidenceMayRewriteCommittedForecast",
    "CommittedForecastMayNotBeDeleted",
    "SupersessionMustAppendANewForecast",
    "ForecastCommitDoesNotEqualRealityValidation"
  ]
}
